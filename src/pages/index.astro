---
import Room from '../components/Room.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Mandeep — 3D Artist</title>
    <meta name="description" content="Portfolio of Mandeep, 3D artist." />
    <!-- Start fetching the model while the JS is still downloading. -->
    <link rel="preload" href="/models/mandeep.glb" as="fetch" crossorigin="anonymous" />
  </head>
  <body>
    <main>
      <Room />
    </main>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    background: #1d1d21;
  }
</style>
