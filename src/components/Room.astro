---
// Renders on the server as plain HTML (the <canvas> and a button). The <script>
// below is bundled by Vite and runs in the browser.
---

<div class="room">
  <canvas id="room" aria-label="Mandeep's 3D room"></canvas>
  <button id="room-back" type="button">← Back to room</button>
  <div id="darts-hud" aria-live="polite">
    <div class="power" aria-hidden="true"><div class="fill"></div><div class="sweet"></div></div>
    <div class="score">
      <strong id="darts-last"></strong>
      <span id="darts-total"></span>
    </div>
    <p class="hint">Aim with the pointer · hold to charge · release at the white line</p>
  </div>
</div>

<script>
  import { mountRoom } from '../scripts/room';

  const canvas = document.querySelector<HTMLCanvasElement>('#room');
  const back = document.querySelector<HTMLButtonElement>('#room-back');
  const hudRoot = document.querySelector<HTMLElement>('#darts-hud');
  const hud = hudRoot && {
    root: hudRoot,
    power: hudRoot.querySelector<HTMLElement>('.power')!,
    last: hudRoot.querySelector<HTMLElement>('#darts-last')!,
    total: hudRoot.querySelector<HTMLElement>('#darts-total')!,
  };
  if (canvas) {
    const room = mountRoom(canvas, hud ?? undefined);
    back?.addEventListener('click', room.backToRoom);
    // Vite re-runs this module on save. Without disposing, every save stacks
    // another renderer + render loop on the same canvas.
    if (import.meta.hot) import.meta.hot.dispose(room.dispose);
  }
</script>

<style>
  .room {
    position: relative; /* the Back button is positioned against this */
  }

  /* The canvas has two sizes: this CSS size (layout) and its drawing buffer
     (set from JS to match). If CSS never set a size, JS would read the buffer
     size back as layout and the canvas would grow every frame. */
  canvas {
    display: block;
    width: 100%;
    height: 100svh;
    touch-action: none; /* otherwise vertical drags scroll the page on mobile */
    cursor: grab;
  }
  canvas:active {
    cursor: grabbing;
  }

  /* room.ts sets data-view on the canvas; CSS shows the button only when focused. */
  #room-back {
    display: none;
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 10px 16px;
    font: 500 15px/1 system-ui, sans-serif;
    color: #f3efe8;
    background: rgb(20 20 24 / 0.75);
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 999px;
    cursor: pointer;
  }
  #room[data-view='dartboard'] + #room-back {
    display: block;
  }
  /* ── Dart HUD: only while the dartboard is focused ── */
  #darts-hud {
    display: none;
    position: absolute;
    inset: auto 16px 16px 16px;
    align-items: flex-end;
    gap: 16px;
    color: #f3efe8;
    font: 500 15px/1.3 system-ui, sans-serif;
    pointer-events: none; /* clicks go through to the canvas */
  }
  #room[data-view='dartboard'] ~ #darts-hud {
    display: flex;
  }
  #darts-hud .score {
    display: grid;
    gap: 2px;
    padding: 10px 14px;
    background: rgb(20 20 24 / 0.75);
    border-radius: 12px;
    min-width: 12ch;
  }
  #darts-hud .hint {
    margin: 0 0 0 auto;
    padding: 8px 12px;
    background: rgb(20 20 24 / 0.6);
    border-radius: 999px;
    font-size: 13px;
  }
  /* Power meter: --power (0..1) is set from darts.ts every frame while charging. */
  #darts-hud .power {
    position: relative;
    width: 18px;
    height: 140px;
    background: rgb(20 20 24 / 0.75);
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 9px;
    overflow: hidden;
  }
  #darts-hud .fill {
    position: absolute;
    inset: auto 0 0 0;
    height: calc(var(--power, 0) * 100%);
    background: linear-gradient(to top, #4fbf6a, #e8c547 60%, #e05545);
  }
  /* Power 0.5 = ideal speed = lands on the reticle. */
  #darts-hud .sweet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 50%;
    height: 2px;
    background: #fff;
  }
  #darts-hud[data-round-over] .hint::before {
    content: 'Round over — press to start the next one · ';
  }
  @media (max-width: 600px) {
    #darts-hud .hint {
      display: none;
    }
  }
  #room-back:focus-visible {
    outline: 2px solid #f3efe8;
    outline-offset: 2px;
  }
</style>
