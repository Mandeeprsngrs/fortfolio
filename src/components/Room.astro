---
// Renders on the server as plain HTML (the <canvas> and a button). The <script>
// below is bundled by Vite and runs in the browser.
import Computer from './Computer.astro';
---

<div class="room">
  <!-- Behind the canvas: the YouTube player for the dresser TV (youtubetv.ts). -->
  <div id="tv-layer" aria-hidden="true"></div>
  <canvas id="room" tabindex="-1" aria-label="Mandeep's 3D room"></canvas>
  <button id="room-back" type="button">← Back to room</button>
  <div id="darts-hud" aria-live="polite">
    <div class="power" aria-hidden="true"><div class="fill"></div><div class="sweet"></div></div>
    <div class="score">
      <strong id="darts-last"></strong>
      <span id="darts-total"></span>
    </div>
    <p class="hint">Aim with the pointer · hold to charge · release at the white line</p>
  </div>
  <!-- Shown by leaderboard.ts when a score makes the top 10. -->
  <form id="hiscore" hidden autocomplete="off">
    <p class="hs-kicker">New high score · <span class="hs-game"></span></p>
    <strong class="hs-score"></strong>
    <label class="hs-label">
      Your initials
      <input name="initials" maxlength="3" spellcheck="false" autocapitalize="characters" inputmode="text" aria-describedby="hs-msg" />
    </label>
    <p class="hs-msg" id="hs-msg" aria-live="polite"></p>
    <div class="hs-actions">
      <button type="button" class="hs-skip">Skip</button>
      <button type="submit">Save</button>
    </div>
  </form>
  <!-- The desk computer's desktop (computer.ts places it over the monitor). -->
  <Computer />
  <!-- Filled in by nowplaying.ts while a poster's song plays. -->
  <div id="now-playing" data-state="stopped" role="status" aria-live="polite">
    <div class="np-disc" aria-hidden="true"><img class="np-label" alt="" /></div>
    <div class="np-meta">
      <span class="np-kicker">Now playing</span>
      <strong class="np-title"></strong>
      <span class="np-artist" hidden></span>
    </div>
    <button class="np-stop" type="button" aria-label="Stop the song">
      <svg viewBox="0 0 40 40" aria-hidden="true">
        <circle class="track" cx="20" cy="20" r="17" />
        <circle class="ring" cx="20" cy="20" r="17" pathLength="100" />
        <rect x="15" y="15" width="10" height="10" rx="1.5" />
      </svg>
    </button>
  </div>
  <!-- Title screen: also the loading screen. Removed on "Enter". -->
  <div id="intro" data-state="loading">
    <div class="intro-card">
      <p class="intro-kicker">Portfolio</p>
      <h1>Mandeep</h1>
      <p class="intro-role">3D Artist</p>
      <p class="intro-text">Step into my room. Most things in it can be clicked: the dartboard, the TV, the posters, the computer.</p>
      <div class="intro-progress" role="progressbar" aria-label="Loading the room" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="intro-bar"></div>
      </div>
      <button id="intro-enter" type="button" disabled>Loading the room…</button>
    </div>
  </div>
</div>

<script>
  import { mountRoom } from '../scripts/room';

  const canvas = document.querySelector<HTMLCanvasElement>('#room');
  const back = document.querySelector<HTMLButtonElement>('#room-back');
  const hudRoot = document.querySelector<HTMLElement>('#darts-hud');
  const hud = hudRoot && {
    root: hudRoot,
    power: hudRoot.querySelector<HTMLElement>('.power')!,
    last: hudRoot.querySelector<HTMLElement>('#darts-last')!,
    total: hudRoot.querySelector<HTMLElement>('#darts-total')!,
  };
  const intro = document.querySelector<HTMLElement>('#intro');
  const enterBtn = document.querySelector<HTMLButtonElement>('#intro-enter');
  const progress = intro?.querySelector<HTMLElement>('.intro-progress');
  if (canvas) {
    const room = mountRoom(canvas, hud ?? undefined, {
      onProgress: (f) => {
        const pct = Math.round(f * 100);
        progress?.style.setProperty('--p', String(f));
        progress?.setAttribute('aria-valuenow', String(pct));
        // Past 100% of the download, textures are still being decoded.
        if (enterBtn && canvas.dataset.state === 'loading') enterBtn.textContent = pct < 100 ? `Loading the room… ${pct}%` : 'Preparing…';
      },
    });
    back?.addEventListener('click', room.backToRoom);
    // room.ts flips canvas[data-state] to ready/error; enable the button then.
    new MutationObserver(() => {
      const state = canvas.dataset.state;
      if (!intro || !enterBtn) return;
      intro.dataset.state = state ?? 'loading';
      if (state === 'ready') {
        enterBtn.disabled = false;
        enterBtn.textContent = 'Enter the room';
        enterBtn.focus();
      } else if (state === 'error') {
        enterBtn.textContent = "Couldn't load the room. Reload to try again.";
      }
    }).observe(canvas, { attributes: true, attributeFilter: ['data-state'] });
    enterBtn?.addEventListener('click', () => {
      room.enter();
      intro?.setAttribute('data-state', 'gone'); // fades out, then hidden via CSS
      canvas.focus();
    });
    // Vite re-runs this module on save. Without disposing, every save stacks
    // another renderer + render loop on the same canvas.
    if (import.meta.hot) import.meta.hot.dispose(room.dispose);
  }
</script>

<style>
  .room {
    position: relative; /* the Back button is positioned against this */
    isolation: isolate; /* own stacking context, so #tv-layer's z-index −1 stays inside it */
  }
  /* The YouTube TV layer sits under the (transparent-where-the-TV-is) canvas. */
  #tv-layer {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  /* The canvas has two sizes: this CSS size (layout) and its drawing buffer
     (set from JS to match). If CSS never set a size, JS would read the buffer
     size back as layout and the canvas would grow every frame. */
  canvas {
    display: block;
    width: 100%;
    height: 100svh;
    touch-action: none; /* otherwise vertical drags scroll the page on mobile */
    cursor: grab;
  }
  canvas:focus {
    outline: none; /* focus is moved here after the title screen; nothing to show */
  }
  canvas:active {
    cursor: grabbing;
  }

  /* room.ts sets data-view on the canvas; CSS shows the button only when focused. */
  #room-back {
    display: none;
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 10px 16px;
    font: 500 15px/1 system-ui, sans-serif;
    color: #f3efe8;
    background: rgb(20 20 24 / 0.75);
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 999px;
    cursor: pointer;
  }
  /* Any focused view (dartboard, console) gets the Back button. */
  #room:not([data-view='room']) + #room-back {
    display: block;
  }
  /* ── Dart HUD: only while the dartboard is focused ── */
  #darts-hud {
    display: none;
    position: absolute;
    inset: auto 16px 16px 16px;
    align-items: flex-end;
    gap: 16px;
    color: #f3efe8;
    font: 500 15px/1.3 system-ui, sans-serif;
    pointer-events: none; /* clicks go through to the canvas */
  }
  #room[data-view='dartboard'] ~ #darts-hud {
    display: flex;
  }
  #darts-hud .score {
    display: grid;
    gap: 2px;
    padding: 10px 14px;
    background: rgb(20 20 24 / 0.75);
    border-radius: 12px;
    min-width: 12ch;
  }
  #darts-hud .hint {
    margin: 0 0 0 auto;
    padding: 8px 12px;
    background: rgb(20 20 24 / 0.6);
    border-radius: 999px;
    font-size: 13px;
  }
  /* Power meter: --power (0..1) is set from darts.ts every frame while charging. */
  #darts-hud .power {
    position: relative;
    width: 18px;
    height: 140px;
    background: rgb(20 20 24 / 0.75);
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 9px;
    overflow: hidden;
  }
  #darts-hud .fill {
    position: absolute;
    inset: auto 0 0 0;
    height: calc(var(--power, 0) * 100%);
    background: linear-gradient(to top, #4fbf6a, #e8c547 60%, #e05545);
  }
  /* Power 0.5 = ideal speed = lands on the reticle. */
  #darts-hud .sweet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 50%;
    height: 2px;
    background: #fff;
  }
  #darts-hud[data-round-over] .hint::before {
    content: 'Round over — press to start the next one · ';
  }
  @media (max-width: 600px) {
    #darts-hud .hint {
      display: none;
    }
  }
  /* ── High-score initials prompt ──────────────────────────────────── */
  #hiscore {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: grid;
    justify-items: center;
    gap: 8px;
    width: min(320px, calc(100% - 32px));
    box-sizing: border-box;
    padding: 20px 22px 18px;
    color: #f3efe8;
    background: rgb(20 20 24 / 0.92);
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: 16px;
    font: 500 15px/1.3 system-ui, sans-serif;
    text-align: center;
  }
  #hiscore[hidden] {
    display: none;
  }
  .hs-kicker {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .hs-score {
    font-size: 40px;
    line-height: 1;
    color: #e8c547;
  }
  .hs-label {
    display: grid;
    gap: 6px;
    font-size: 13px;
    opacity: 0.85;
  }
  .hs-label input {
    width: 4.2ch;
    padding: 6px 8px;
    font: bold 32px/1 monospace;
    letter-spacing: 0.25em;
    text-align: center;
    text-transform: uppercase;
    color: #f3efe8;
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 8px;
    justify-self: center;
  }
  .hs-msg {
    min-height: 1.3em;
    margin: 0;
    font-size: 13px;
    color: #f0a58a;
  }
  .hs-actions {
    display: flex;
    gap: 10px;
  }
  .hs-actions button {
    padding: 8px 18px;
    font: 600 14px/1 system-ui, sans-serif;
    color: #f3efe8;
    background: rgb(255 255 255 / 0.1);
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 999px;
    cursor: pointer;
  }
  .hs-actions button[type='submit'] {
    color: #141418;
    background: #e8c547;
    border-color: #e8c547;
  }
  .hs-actions button:disabled {
    opacity: 0.5;
    cursor: wait;
  }
  .hs-actions button:focus-visible,
  .hs-label input:focus-visible {
    outline: 2px solid #f3efe8;
    outline-offset: 2px;
  }

  /* ── Now playing card ─────────────────────────────────────────────── */
  #now-playing {
    position: absolute;
    left: 16px;
    bottom: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 10px 8px 8px;
    max-width: calc(100% - 32px);
    color: #f3efe8;
    background: rgb(20 20 24 / 0.8);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 999px;
    font: 500 14px/1.25 system-ui, sans-serif;
    /* Hidden state: faded, nudged down, not clickable. */
    opacity: 0;
    translate: 0 12px;
    pointer-events: none;
    transition: opacity 0.3s, translate 0.3s;
  }
  #now-playing[data-state='playing'] {
    opacity: 1;
    translate: 0 0;
    pointer-events: auto;
  }
  /* A record: black with faint grooves (repeating rings) and a sheen. */
  .np-disc {
    flex: none;
    position: relative;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 0.14), transparent 45%, rgb(255 255 255 / 0.06) 70%, transparent),
      repeating-radial-gradient(circle, #111 0 1px, #1c1c1c 1px 2.5px);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.08), 0 2px 8px rgb(0 0 0 / 0.5);
    animation: np-spin 1.8s linear infinite; /* 33⅓ rpm */
    animation-play-state: paused;
  }
  #now-playing[data-state='playing'] .np-disc {
    animation-play-state: running;
  }
  /* The cover as the centre label; object-fit picks its middle square. */
  .np-label {
    position: absolute;
    inset: 30%;
    width: 40%;
    height: 40%;
    border-radius: 50%;
    object-fit: cover;
  }
  .np-disc::after {
    /* spindle hole */
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    margin: -2px 0 0 -2px;
    border-radius: 50%;
    background: #141418;
  }
  @keyframes np-spin {
    to { rotate: 1turn; }
  }
  .np-meta {
    display: grid;
    min-width: 0;
  }
  .np-kicker {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .np-title,
  .np-artist {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .np-artist {
    font-size: 13px;
    opacity: 0.75;
  }
  .np-stop {
    flex: none;
    width: 40px;
    height: 40px;
    padding: 0;
    color: #f3efe8;
    background: none;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }
  .np-stop svg {
    display: block;
    width: 100%;
    height: 100%;
    rotate: -90deg; /* progress starts at 12 o'clock */
  }
  .np-stop .track,
  .np-stop .ring {
    fill: none;
    stroke-width: 2.5;
  }
  .np-stop .track {
    stroke: rgb(255 255 255 / 0.15);
  }
  /* pathLength=100 makes the dash maths a percentage: offset = 100 × (1 − p). */
  .np-stop .ring {
    stroke: #e8c547;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: calc(100 * (1 - var(--p, 0)));
  }
  .np-stop rect {
    fill: currentColor;
  }
  .np-stop:focus-visible {
    outline: 2px solid #f3efe8;
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .np-disc {
      animation: none;
    }
  }
  /* ── Title screen ─────────────────────────────────────────────────── */
  #intro {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 16px;
    background: rgb(14 14 18 / 0.78); /* the room renders, dimmed, behind */
    transition: opacity 0.6s, visibility 0.6s;
  }
  #intro[data-state='gone'] {
    opacity: 0;
    visibility: hidden; /* no longer blocks clicks once faded */
  }
  .intro-card {
    display: grid;
    justify-items: center;
    gap: 6px;
    max-width: 440px;
    color: #f3efe8;
    text-align: center;
    font: 400 16px/1.5 system-ui, sans-serif;
  }
  .intro-kicker {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .intro-card h1 {
    margin: 0;
    font: 700 clamp(44px, 11vw, 76px) / 1 system-ui, sans-serif;
    letter-spacing: -0.02em;
  }
  .intro-role {
    margin: 0 0 8px;
    font-size: 18px;
    color: #e8c547;
  }
  .intro-text {
    margin: 0 0 18px;
    opacity: 0.8;
  }
  .intro-progress {
    width: min(260px, 100%);
    height: 4px;
    margin-bottom: 14px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.15);
    border-radius: 2px;
  }
  .intro-bar {
    width: calc(var(--p, 0) * 100%);
    height: 100%;
    background: #e8c547;
    transition: width 0.2s;
  }
  #intro[data-state='ready'] .intro-progress,
  #intro[data-state='gone'] .intro-progress {
    visibility: hidden;
  }
  #intro-enter {
    padding: 12px 26px;
    font: 600 16px/1 system-ui, sans-serif;
    color: #141418;
    background: #e8c547;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
  }
  #intro-enter:disabled {
    color: #f3efe8;
    background: rgb(255 255 255 / 0.12);
    cursor: progress;
  }
  #intro-enter:focus-visible {
    outline: 2px solid #f3efe8;
    outline-offset: 3px;
  }

  #room-back:focus-visible {
    outline: 2px solid #f3efe8;
    outline-offset: 2px;
  }
</style>
